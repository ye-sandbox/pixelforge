# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — pixelforge
# ==============================================================================
# Copy this file to `.env` only when overriding local defaults:
# cp .env.example .env
#
# RULE: NEVER commit `.env` containing sensitive credentials to the repository.
# ==============================================================================

# [CLI / Exporter Defaults]
PIXELFORGE_OUT_DIR=dist
PIXELFORGE_SHEETS_DIR=.pixelforge/sheets
PIXELFORGE_PREVIEWS_DIR=.pixelforge/previews
PIXELFORGE_DIFFS_DIR=.pixelforge/diffs
PIXELFORGE_DEFAULT_STYLE=homelab-16bit

# [Optional: Autonomous Multimodal Visual Critic via hydra-llm-router (OpenAI v1)]
# Leave unset for standard local/IDE multimodal agent workflows.
# External/Traefik: https://hydra-router.homelab.yegear.dev/v1 | Localhost: http://127.0.0.1:3000/v1
LLM_BASE_URL=https://hydra-router.homelab.yegear.dev/v1
LLM_API_KEY=sk-replace-with-hydra-client-or-master-token
LLM_MODEL_FAST=fast
LLM_TIMEOUT_SECONDS=120
# Opt-in ONLY for local dev review (--tier dev / --model):
# LLM_MODEL_DEEP=deep
# LLM_MODEL_DEV=deep
