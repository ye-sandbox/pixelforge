# Secrets — never commit
.env
.env.*
!.env.example

# Python & uv environments / caches
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Build & package outputs
dist/
build/
coverage/
*.log

# Ephemeral visual critic sheets & reference scratch (never commit reference photos)
.pixelforge/
shots/

# OS / IDE / agent scratch
.DS_Store
Thumbs.db
.idea/
.vscode/
.agent/scratch/
.agent/.cache/
.worktrees/
.gemini/
.claude/
.maestri/
.multigravity/

# dev-harness local-first state (queue contracts live in git; runtime state does not)
.harness/queue/done/
.harness/queue/escalated/
.harness/worktrees/
